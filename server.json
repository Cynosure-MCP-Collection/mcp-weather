{
    "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
    "name": "io.github.andreasjhagen/weather",
    "description": "MCP server that fetches current weather and forecasts using the free Open-Meteo API",
    "version": "1.0.1",
    "icons": [
        {
            "src": "https://raw.githubusercontent.com/andreasjhagen/OpenAgent-MCPs/main/mcp-weather/icon.png",
            "mimeType": "image/png"
        }
    ],
    "packages": [
        {
            "registryType": "npm",
            "identifier": "@cynosure-mcp/weather",
            "version": "1.0.1",
            "transport": {
                "type": "stdio"
            },
            "environmentVariables": []
        }
    ],
    "repository": {
        "url": "https://github.com/andreasjhagen/OpenAgent-MCPs",
        "source": "github",
        "subfolder": "mcp-weather"
    }
}
