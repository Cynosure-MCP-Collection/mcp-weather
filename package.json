{
  "name": "@cynosure-mcp/weather",
  "mcpName": "io.github.andreasjhagen/weather",
  "version": "1.0.5",
  "description": "MCP server that fetches current weather and forecasts using the free Open-Meteo API",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "weather": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "release:check": "node scripts/sync-version.mjs --check",
    "version": "node scripts/sync-version.mjs && git add server.json"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.27.1",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  },
  "files": [
    "dist",
    "server.json",
    "icon.png"
  ],
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "weather",
    "forecast",
    "open-meteo",
    "ai"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Cynosure-MCP-Collection/mcp-weather.git"
  },
  "homepage": "https://github.com/Cynosure-MCP-Collection/mcp-weather#readme",
  "bugs": {
    "url": "https://github.com/Cynosure-MCP-Collection/mcp-weather/issues"
  }
}
